{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DOMINION appearance-only preset v1",
  "type": "object",
  "required": [
    "format",
    "appearance"
  ],
  "properties": {
    "format": {
      "const": "dominion-appearance-v1"
    },
    "appearance": {
      "type": "object",
      "required": [
        "portrait_archetype",
        "hair"
      ],
      "properties": {
        "portrait_archetype": {
          "type": "string"
        },
        "hair": {
          "type": "string"
        },
        "style_family": {
          "enum": [
            "dominion-stylized-foundation-v1",
            "dominion-modular-foundation-v1",
            "everyday-illustrated-v1",
            "dominion-all-options-v1"
          ]
        },
        "skin_color_id": {
          "$ref": "#/$defs/palette_id"
        },
        "hair_primary_color_id": {
          "$ref": "#/$defs/palette_id"
        },
        "hair_accent_color_id": {
          "$ref": "#/$defs/palette_id"
        },
        "outfit_primary_color_id": {
          "$ref": "#/$defs/palette_id"
        },
        "portrait_equipment": {
          "type": "object"
        },
        "goggle_package": {
          "type": "string"
        },
        "lower_face_package": {
          "type": "string"
        },
        "detail_package": {
          "type": "string"
        },
        "outfit_accent_color_id": {
          "$ref": "#/$defs/palette_id"
        },
        "torso": {
          "type": "string"
        },
        "eye_package": {
          "type": "string"
        },
        "nose_package": {
          "type": "string"
        },
        "mouth_package": {
          "type": "string"
        },
        "iris_color_id": {
          "$ref": "#/$defs/palette_id"
        },
        "portrait_rgb": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "skin": {
              "type": "integer",
              "minimum": 0,
              "maximum": 16777215
            },
            "hair": {
              "type": "integer",
              "minimum": 0,
              "maximum": 16777215
            },
            "hairAccent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 16777215
            },
            "outfit": {
              "type": "integer",
              "minimum": 0,
              "maximum": 16777215
            },
            "accessory": {
              "type": "integer",
              "minimum": 0,
              "maximum": 16777215
            },
            "iris": {
              "type": "integer",
              "minimum": 0,
              "maximum": 16777215
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "palette_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 23
    }
  },
  "additionalProperties": false
}
