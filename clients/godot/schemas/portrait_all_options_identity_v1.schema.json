{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dominion-all-options-v1 portrait identity",
  "type": "object",
  "required": [
    "style_family",
    "portrait_schema",
    "library_revision",
    "portrait_archetype",
    "hair",
    "skin_color_id",
    "hair_primary_color_id",
    "hair_accent_color_id",
    "outfit_primary_color_id"
  ],
  "properties": {
    "style_family": {
      "const": "dominion-all-options-v1"
    },
    "portrait_schema": {
      "const": 10
    },
    "library_revision": {
      "const": 1
    },
    "portrait_archetype": {
      "enum": [
        "mix_everyday_face_1",
        "mix_everyday_face_2",
        "mix_everyday_face_3",
        "mix_cyberpunk_face_1",
        "mix_cyberpunk_face_2",
        "mix_cyberpunk_face_3",
        "mix_cyberpunk_face_4"
      ]
    },
    "hair": {
      "enum": [
        "mix_everyday_bald",
        "mix_everyday_swept",
        "mix_everyday_curly",
        "mix_cyberpunk_bald",
        "mix_cyberpunk_swept",
        "mix_cyberpunk_short"
      ]
    },
    "skin_color_id": {
      "$ref": "#/$defs/palette_id"
    },
    "hair_primary_color_id": {
      "$ref": "#/$defs/palette_id"
    },
    "hair_accent_color_id": {
      "$ref": "#/$defs/palette_id"
    },
    "outfit_primary_color_id": {
      "$ref": "#/$defs/palette_id"
    },
    "goggle_package": {
      "enum": [
        "mix_everyday_none",
        "mix_everyday_glasses",
        "mix_cyberpunk_none",
        "mix_cyberpunk_glasses"
      ]
    },
    "lower_face_package": {
      "enum": [
        "mix_everyday_none",
        "mix_cyberpunk_none",
        "mix_cyberpunk_mask"
      ]
    },
    "detail_package": {
      "enum": [
        "mix_everyday_none",
        "mix_cyberpunk_none",
        "mix_cyberpunk_implant"
      ]
    },
    "outfit_accent_color_id": {
      "$ref": "#/$defs/palette_id"
    },
    "torso": {
      "enum": [
        "mix_everyday_crew",
        "mix_everyday_collar",
        "mix_cyberpunk_jacket"
      ]
    },
    "eye_package": {
      "enum": [
        "eyes_foundation",
        "mix_everyday_almond",
        "mix_everyday_narrow",
        "mix_cyberpunk_almond",
        "mix_cyberpunk_narrow"
      ]
    },
    "nose_package": {
      "enum": [
        "nose_original",
        "mix_everyday_straight",
        "mix_everyday_broad",
        "mix_cyberpunk_straight",
        "mix_cyberpunk_broad"
      ]
    },
    "mouth_package": {
      "enum": [
        "mouth_foundation",
        "mix_everyday_neutral",
        "mix_everyday_full",
        "mix_cyberpunk_neutral",
        "mix_cyberpunk_full"
      ]
    },
    "iris_color_id": {
      "$ref": "#/$defs/palette_id"
    }
  },
  "$defs": {
    "palette_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 23
    }
  },
  "additionalProperties": true
}
