{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "everyday-illustrated-v1 portrait identity",
  "type": "object",
  "required": [
    "style_family",
    "portrait_schema",
    "library_revision",
    "portrait_archetype",
    "hair",
    "skin_color_id",
    "hair_primary_color_id",
    "hair_accent_color_id",
    "outfit_primary_color_id"
  ],
  "properties": {
    "style_family": {
      "const": "everyday-illustrated-v1"
    },
    "portrait_schema": {
      "const": 10
    },
    "library_revision": {
      "const": 1
    },
    "portrait_archetype": {
      "enum": [
        "everyday_face_1",
        "everyday_face_2",
        "everyday_face_3"
      ]
    },
    "hair": {
      "enum": [
        "everyday_bald",
        "everyday_swept",
        "everyday_curly"
      ]
    },
    "skin_color_id": {
      "$ref": "#/$defs/palette_id"
    },
    "hair_primary_color_id": {
      "$ref": "#/$defs/palette_id"
    },
    "hair_accent_color_id": {
      "$ref": "#/$defs/palette_id"
    },
    "outfit_primary_color_id": {
      "$ref": "#/$defs/palette_id"
    },
    "goggle_package": {
      "enum": [
        "everyday_none",
        "everyday_glasses"
      ]
    },
    "lower_face_package": {
      "enum": [
        "lower_exposed"
      ]
    },
    "detail_package": {
      "enum": [
        "detail_none"
      ]
    },
    "outfit_accent_color_id": {
      "$ref": "#/$defs/palette_id"
    },
    "torso": {
      "enum": [
        "everyday_crew",
        "everyday_collar"
      ]
    },
    "eye_package": {
      "enum": [
        "eyes_foundation",
        "day_eyes_almond",
        "day_eyes_narrow"
      ]
    },
    "nose_package": {
      "enum": [
        "nose_original",
        "day_nose_straight",
        "day_nose_broad"
      ]
    },
    "mouth_package": {
      "enum": [
        "mouth_foundation",
        "day_mouth_neutral",
        "day_mouth_full"
      ]
    },
    "iris_color_id": {
      "$ref": "#/$defs/palette_id"
    }
  },
  "$defs": {
    "palette_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 23
    }
  },
  "additionalProperties": true
}
